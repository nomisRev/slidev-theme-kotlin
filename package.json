{
  "name": "slidev-theme-kotlin",
  "version": "0.11.0",
  "type": "module",
  "exports": {
    "./annotation-editor": "./annotation-editor.ts"
  },
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "assets",
    "components",
    "plugins",
    "annotation-editor.ts",
    "global-top.vue",
    "layouts",
    "public",
    "setup",
    "styles",
    "slide-bottom.vue",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node scripts/lint-slides.mjs slides.md",
    "build": "npm run lint && slidev build slides.md && node scripts/assert-production-annotation-editor.mjs",
    "dev": "slidev slides.md --open",
    "export": "slidev export slides.md",
    "export:slide": "node scripts/export-slide.mjs",
    "screenshot": "slidev export slides.md --format png --with-clicks",
    "visual:review": "node scripts/visual-review.mjs",
    "visual:check": "node scripts/visual-review.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@slidev/types": "52.19.1",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@slidev/cli": "52.19.1",
    "@slidev/parser": "52.19.1",
    "pixelmatch": "7.2.0",
    "playwright-chromium": "1.62.1",
    "pngjs": "7.0.0",
    "vitest": "4.1.11"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Inter",
        "mono": "JetBrains Mono"
      }
    }
  }
}
