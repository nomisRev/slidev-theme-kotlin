{
  "name": "slidev-theme-kotlin",
  "version": "0.10.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "assets",
    "components",
    "layouts",
    "public",
    "setup",
    "styles",
    "slide-bottom.vue",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node scripts/lint-slides.mjs slides.md",
    "build": "npm run lint && slidev build slides.md",
    "dev": "slidev slides.md --open",
    "export": "slidev export slides.md",
    "screenshot": "slidev export slides.md --format png --with-clicks",
    "visual:review": "node scripts/visual-review.mjs",
    "visual:check": "node scripts/visual-review.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@slidev/types": "^52.2.5",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@slidev/cli": "^52.2.5",
    "@slidev/parser": "^52.2.5",
    "pixelmatch": "^7.2.0",
    "playwright-chromium": "^1.62.1",
    "pngjs": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Inter",
        "mono": "JetBrains Mono"
      }
    }
  }
}
